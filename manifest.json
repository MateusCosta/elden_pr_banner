{
  "manifest_version": 3,
  "name": "Elden PR",
  "version": "1.0.0",
  "description": "Shows an Elden Ring banner when you create a pull request",
  "permissions": ["storage"],
   "action": {
      "default_popup": "popup.html",
      "default_icon": {
        "48": "assets/icon.png"
      }
   },
    "host_permissions": [
      "https://github.com/*"
    ],
  "content_scripts": [
    {
      "matches": [
        "https://github.com/*"
      ],
      "js": ["content.js"],
      "css": ["style.css"]
    }
  ],
  "icons": {
    "48": "assets/icon.png"
  },
  "web_accessible_resources": [
    {
      "resources": ["assets/pr_created_yellow.png", "assets/pr_created_blue.png", "assets/pr_created_red.png","assets/elden_ring_sound.mp3", "assets/Matinia.otf"],
      "matches": [
        "https://github.com/*"
      ]
    }
  ]
}

